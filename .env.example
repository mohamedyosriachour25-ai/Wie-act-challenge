# Copy to .env (never commit it). Used by docker compose; for local runs without Docker use backend/.env.
# Random signing secret for sessions: openssl rand -hex 32   (PowerShell: -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) }))
HERWIEGO_SECRET=

# Required, in every environment -- there is no built-in fallback. Set the base URL, the team key
# and the model ids listed by GET /v1/models. The key is personal to the team: never commit it or
# show it in screenshots.
HERWIEGO_BASE_URL=
HERWIEGO_API_KEY=
HERWIEGO_COMPACT_MODEL=compact-1b
HERWIEGO_MID_MODEL=mid-8b
HERWIEGO_EMBED_MODEL=embed-small
HERWIEGO_MIN_SIMILARITY=0.1
HERWIEGO_MAX_CONCURRENT=2

# AI actions one learner may start per minute (protects the shared team quota).
HERWIEGO_USER_AI_PER_MIN=20
# Set to 1 only when running behind your own reverse proxy that sets X-Forwarded-For.
HERWIEGO_TRUST_PROXY=0
# Cameras allowed on one Live-room wall at once (peer-to-peer mesh).
HERWIEGO_VIDEO_CAPACITY=6
