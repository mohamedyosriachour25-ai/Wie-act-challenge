# Copy to .env (never commit it). Used by docker compose; for local runs without Docker use backend/.env.
# Random signing secret for sessions: openssl rand -hex 32   (PowerShell: -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) }))
EDNOVA_SECRET=

# "mock" = built-in fake AI service. For the real service set the base URL, the team key and the model ids
# listed by GET /v1/models. The key is personal to the team: never commit it or show it in screenshots.
EDNOVA_BASE_URL=mock
EDNOVA_API_KEY=
EDNOVA_COMPACT_MODEL=compact-1b
EDNOVA_MID_MODEL=mid-8b
EDNOVA_EMBED_MODEL=embed-small
EDNOVA_MIN_SIMILARITY=0.1
EDNOVA_MAX_CONCURRENT=2

# AI actions one learner may start per minute (protects the shared team quota).
EDNOVA_USER_AI_PER_MIN=20
# Set to 1 only when running behind your own reverse proxy that sets X-Forwarded-For.
EDNOVA_TRUST_PROXY=0
# Cameras allowed on one Live-room wall at once (peer-to-peer mesh).
EDNOVA_VIDEO_CAPACITY=6
