# Copy to .env (never commit .env). Both of these are required -- there is no built-in fallback;
# the app refuses to start without them.

# Base URL given by the organisers.
HERWIEGO_BASE_URL=
# Your team key. Personal to the team: never commit it, never show it in logs, screenshots or videos.
HERWIEGO_API_KEY=
# Model ids as listed by GET /v1/models. Compact = classification/short tasks (<3B);
# Mid = reasoning and final writing (<=16B). Example values for a typical service:
HERWIEGO_COMPACT_MODEL=llama3.2-3b
HERWIEGO_MID_MODEL=llama3.1-8b
# Embeddings model id. The embeddings endpoint is metered separately and is often NOT listed
# by /v1/models -- ask the organisers for the id, then test it with POST <base>/v1/embeddings.
# If embeddings are unavailable, "My courses" still works via keyword search (documents are
# added as searchable, not failed); set HERWIEGO_SEMANTIC_CACHE=0 below to skip the extra calls.
HERWIEGO_EMBED_MODEL=embed-small
# Floor for a passage's relevance (0.8 cosine + 0.2 keyword). Retrieval also drops anything under half the best
# score, so this floor only needs to rule out clearly unrelated passages; 0.1 is a safe start.
HERWIEGO_MIN_SIMILARITY=0.1
# Scanned PDF pages are read by this OCR model (one call per page). Empty = scanned PDFs are kept as files only.
HERWIEGO_OCR_MODEL=deepseek-ocr
HERWIEGO_OCR_MAX_PAGES=40
HERWIEGO_MAX_PDF_MB=20
# Vectors are kept in this app's database: leave this on local (the supported setup).
HERWIEGO_VECTOR_BACKEND=local
# Maximum concurrent requests allowed per key (see the guide's additional ceilings).
HERWIEGO_MAX_CONCURRENT=2

HERWIEGO_SECRET=change-me-for-any-shared-deployment
HERWIEGO_DB=herwiego.db

# development (default) or production. Production additionally refuses a weak HERWIEGO_SECRET and hides /docs.
HERWIEGO_ENV=development
# AI actions one learner may start per minute: one account must not drain the team's shared quota.
HERWIEGO_USER_AI_PER_MIN=20
# Failed sign-ins per 5 minutes per pseudo (the per-connection ceiling is 5x this).
HERWIEGO_LOGIN_ATTEMPTS=8
# Only behind your own reverse proxy that sets X-Forwarded-For.
HERWIEGO_TRUST_PROXY=0
HERWIEGO_LOG_LEVEL=INFO
# How many cameras may share one Live room at once (peer-to-peer mesh).
HERWIEGO_VIDEO_CAPACITY=6

# Semantic cache: reuse a result when a new request means the same as a recent one (embeddings-based).
HERWIEGO_SEMANTIC_CACHE=1
HERWIEGO_SEM_THRESHOLD=0.86
HERWIEGO_SEM_THRESHOLD_ASK=0.93

# Draft-then-revise: a compact pass reviews the mid-size quiz before the student sees it.
HERWIEGO_QUIZ_VERIFY=1

# Solo study spaces (staged tutor). The service answers whole (no streaming, per the guide), so each
# finished stage is pushed to the browser: intent -> sources -> quick draft -> final answer -> figure.
# Draft-then-revise: the compact model writes a quick draft shown within seconds; the mid-size model
# corrects and completes it (final user-facing writing). 0 = mid-size answer only (one call fewer).
HERWIEGO_QUICK_DRAFT=1
# Declared external source: Wikipedia lookups (no key) when a space's material does not cover a question.
# Learners can also switch it off per message. Only the rewritten question is sent, never personal data.
HERWIEGO_WEB_SEARCH=1
HERWIEGO_WEB_TIMEOUT_S=3.5
# Conversation memory per space: last N messages verbatim + a running summary of older ones (compact).
HERWIEGO_MEMORY_WINDOW=6
HERWIEGO_MEMORY_FOLD_AFTER=10
HERWIEGO_MAX_SPACES=12

# Group games on the break in public rooms.
HERWIEGO_EVENT_LEAD_S=300
HERWIEGO_EVENT_MIN_PLAYERS=2
