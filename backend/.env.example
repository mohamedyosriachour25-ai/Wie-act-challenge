# Copy to .env (never commit .env). Without this file the built-in fake service is used.

# Base URL given by the organisers. "mock" = built-in fake service for development and demos.
EDNOVA_BASE_URL=mock
# Your team key. Personal to the team: never commit it, never show it in logs, screenshots or videos.
EDNOVA_API_KEY=replace-me
# Model ids as listed by GET /v1/models on the real service.
EDNOVA_COMPACT_MODEL=compact-1b
EDNOVA_MID_MODEL=mid-8b
# Embeddings model id (the embeddings endpoint is metered separately from generation).
EDNOVA_EMBED_MODEL=embed-small
# Passages scoring below this cosine similarity are treated as not relevant. Tune it on the real embeddings.
EDNOVA_MIN_SIMILARITY=0.1
# Maximum concurrent requests allowed per key (see the guide's additional ceilings).
EDNOVA_MAX_CONCURRENT=2

EDNOVA_SECRET=change-me-for-any-shared-deployment
EDNOVA_DB=ednova.db

# development (default) or production. Production refuses a weak EDNOVA_SECRET or a missing key and hides /docs.
EDNOVA_ENV=development
# AI actions one learner may start per minute: one account must not drain the team's shared quota.
EDNOVA_USER_AI_PER_MIN=20
# Failed sign-ins per 5 minutes per pseudo (the per-connection ceiling is 5x this).
EDNOVA_LOGIN_ATTEMPTS=8
# Only behind your own reverse proxy that sets X-Forwarded-For.
EDNOVA_TRUST_PROXY=0
EDNOVA_LOG_LEVEL=INFO
# How many cameras may share one Live room at once (peer-to-peer mesh).
EDNOVA_VIDEO_CAPACITY=6
